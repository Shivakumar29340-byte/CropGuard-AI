
# ==========================================
# CropGuard AI - Git Ignore
# ==========================================

# Python virtual environments
venv/
env/
.venv/
backend/venv/
backend/env/

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node.js dependencies
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
package-lock-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# Blockchain local configuration
backend/blockchain_config.json

# Dataset files
dataset/
PlantVillage/
*.zip

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
*.tmp
*.bak
temp/
tmp/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE settings
.vscode/
.idea/

# Model training checkpoints
*.ckpt
*.h5
*.weights

# Keep model folder placeholder and class labels
!backend/models/.gitkeep
!backend/models/class_names.json
